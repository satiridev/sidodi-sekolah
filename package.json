{
  "name": "arsip-sekolah",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS arsip digital sekolah (compliance-first) — monorepo",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "npm run test --workspace @arsip/e2e",
    "test:e2e:api": "npm run test:api --workspace @arsip/e2e",
    "test:e2e:web": "npm run test:web --workspace @arsip/e2e",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "docs:html": "node docs/build-html.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
