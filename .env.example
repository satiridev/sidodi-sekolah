# Database (PostgreSQL — wajib region Indonesia di produksi)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arsip_sekolah?schema=public"

# API
PORT=3001
JWT_SECRET="ganti-dengan-secret-acak-panjang-minimal-32-karakter"

# Cookie sesi httpOnly (opsional). Isi dengan domain induk bila web & API berada
# pada subdomain berbeda, mis. ".sekolah.id". Kosongkan untuk host-only (localhost).
COOKIE_DOMAIN=""

# E-Ijazah (opsional)
# Kunci HMAC untuk tanda tangan elektronik ijazah. Bila kosong, memakai JWT_SECRET.
EIJAZAH_SIGNING_KEY=""
# Base URL web untuk tautan/QR verifikasi ijazah (mis. https://arsip.sekolah.id).
PUBLIC_APP_URL="http://localhost:3000"

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Object storage S3-compatible (region Indonesia)
S3_ENDPOINT=""
S3_REGION="ap-southeast-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
